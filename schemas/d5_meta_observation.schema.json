{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jaydumisuni/mtk-meta-boot-research-handoff/schemas/d5_meta_observation.schema.json",
  "title": "D5 MTK META sanitized observation",
  "type": "object",
  "required": ["schema_version", "analyzer_version", "run_id", "created_at", "safety", "runs", "verdict", "next_experiment"],
  "properties": {
    "schema_version": { "const": "d5-meta-observation/1.0" },
    "analyzer_version": { "type": "string" },
    "run_id": { "type": "string", "pattern": "^D5_[0-9]{8}_[0-9]{6}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "safety": {
      "type": "object",
      "required": ["mode", "device_commands_executed_by_analyzer", "raw_unique_identifiers_published", "raw_logs_retained_locally"],
      "properties": {
        "mode": { "const": "READ_ONLY" },
        "device_commands_executed_by_analyzer": { "const": false },
        "raw_unique_identifiers_published": { "const": false },
        "raw_logs_retained_locally": { "const": true }
      },
      "additionalProperties": false
    },
    "usb_timeline": { "type": "array", "items": { "type": "object" } },
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["run_id", "label", "timed_out", "return_codes", "callback_seen", "exceptions", "key_events"],
        "properties": {
          "run_id": { "type": "string" },
          "label": { "type": "string" },
          "exit_code": { "type": ["integer", "null"] },
          "timed_out": { "type": "boolean" },
          "duration_ms": { "type": ["integer", "null"] },
          "return_codes": { "type": "object" },
          "callback_seen": { "type": "boolean" },
          "exceptions": { "type": "array", "items": { "type": "string" } },
          "key_events": { "type": "array", "items": { "type": "string" } },
          "stdout_file": { "type": ["string", "null"] },
          "stderr_file": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "verdict": {
      "type": "object",
      "required": ["code", "reason"],
      "properties": {
        "code": {
          "enum": [
            "INCOMPLETE",
            "META_BOOT_CONFIRMED_AP_INVESTIGATE",
            "AP_META_CERTIFIED_MD_INVESTIGATE",
            "MD_BRIDGE_CONFIRMED",
            "READ_PATH_CERTIFIED"
          ]
        },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "next_experiment": {
      "type": "object",
      "required": ["experiment_id", "objective", "safety"],
      "properties": {
        "experiment_id": { "type": "string" },
        "objective": { "type": "string" },
        "driven_by_hypothesis": { "type": ["string", "null"] },
        "hypothesis_statement": { "type": ["string", "null"] },
        "safety": { "const": "READ_ONLY" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
